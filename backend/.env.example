# 9D Brain backend configuration
#
# Copy to .env for local development only. Production values must be injected
# by the deployment platform/secret manager; never commit a populated .env.

# Required core settings
AIBOS_ENVIRONMENT=development
AIBOS_DEBUG=true
AIBOS_APP_VERSION=0.1.0
AIBOS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/ai_business_os
AIBOS_DATABASE_SSL_MODE=disable
AIBOS_AUTH_SECRET_KEY=development-only-change-me-before-deploy-32-bytes-minimum

# API and browser origins
AIBOS_DOCS_ENABLED=true
AIBOS_REQUEST_MAX_BYTES=2097152
AIBOS_TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
AIBOS_FRONTEND_BASE_URL=http://localhost:5174
AIBOS_CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174"]
AIBOS_PUBLIC_API_BASE_URL=http://localhost:8000
AIBOS_WIDGET_LOADER_URL=http://localhost:5174/widget-loader.js
AIBOS_WIDGET_APP_URL=http://localhost:5174/widget.html
AIBOS_AUTH_REFRESH_COOKIE_SECURE=false

# Database/process tuning
AIBOS_DATABASE_POOL_SIZE=10
AIBOS_DATABASE_MAX_OVERFLOW=20
AIBOS_DATABASE_POOL_TIMEOUT=30
AIBOS_DATABASE_POOL_RECYCLE_SECONDS=1800
AIBOS_DATABASE_CONNECT_TIMEOUT_SECONDS=10
AIBOS_DATABASE_COMMAND_TIMEOUT_SECONDS=60
AIBOS_JOB_POLL_INTERVAL_SECONDS=1
AIBOS_JOB_BATCH_SIZE=10
AIBOS_JOB_LEASE_SECONDS=300
AIBOS_SCHEDULER_POLL_INTERVAL_SECONDS=5
AIBOS_SCHEDULER_BATCH_SIZE=100

# Logging and edge contract
AIBOS_LOG_LEVEL=INFO
AIBOS_LOG_FORMAT=text
AIBOS_EDGE_RATE_LIMITING_ENABLED=false
# Keep false until production deployment, backups, monitoring, smoke tests,
# and the first-client activation checklist have been completed.
AIBOS_FIRST_CLIENT_ACTIVATION_ENABLED=false

# Billing checkout remains authoritative by default. Enable only for a
# controlled product-acceptance environment; the backend enforces this flag.
AIBOS_BILLING_TEST_MODE=false

# Object storage. Production/staging requires a durable S3-compatible backend.
AIBOS_STORAGE_BACKEND=local
# AIBOS_STORAGE_BUCKET=install-through-deployment-platform
# AIBOS_STORAGE_REGION=install-through-deployment-platform
# AIBOS_STORAGE_ENDPOINT_URL=https://object-storage.example.invalid
# AIBOS_STORAGE_ACCESS_KEY_ID=install-through-secret-manager
# AIBOS_STORAGE_SECRET_ACCESS_KEY=install-through-secret-manager
# AIBOS_STORAGE_PUBLIC_BASE_URL=https://assets.example.invalid

# AI provider (optional until AI execution is enabled)
AIBOS_OPENAI_MODEL=gpt-5.6-terra
AIBOS_OPENAI_TIMEOUT_SECONDS=45
AIBOS_OPENAI_MAX_RETRIES=2
# AIBOS_OPENAI_API_KEY=install-through-secret-manager

# Integration credential storage and stable callback
AIBOS_INTEGRATION_CREDENTIAL_BACKEND=disabled
# AIBOS_INTEGRATION_SECRET_REGION=install-through-deployment-platform
# AIBOS_INTEGRATION_SECRET_KMS_KEY_ID=install-through-deployment-platform
# AIBOS_INTEGRATION_OAUTH_CALLBACK_URL=https://app.example.invalid/api/v1/integrations/oauth/callback

# External writes fail closed. Test mode may request write scopes but cannot
# dispatch provider mutations. Production writes require BOTH values below.
AIBOS_EXTERNAL_CONNECTOR_WRITES_ENABLED=false
AIBOS_EXTERNAL_CONNECTOR_WRITE_MODE=disabled

# Provider credentials are optional at core startup. Configure only providers
# undergoing controlled acceptance; install all secrets out-of-band.
# AIBOS_GOOGLE_OAUTH_CLIENT_ID=install-through-deployment-platform
# AIBOS_GOOGLE_OAUTH_CLIENT_SECRET=install-through-secret-manager
# AIBOS_GOOGLE_ADS_DEVELOPER_TOKEN=install-through-secret-manager
# AIBOS_META_OAUTH_CLIENT_ID=install-through-deployment-platform
# AIBOS_META_OAUTH_CLIENT_SECRET=install-through-secret-manager
# AIBOS_META_LOGIN_CONFIGURATION_ID=install-through-deployment-platform
# Existing Render aliases META_APP_ID, META_APP_SECRET, and
# META_LOGIN_CONFIG_ID are also accepted. Never expose the secret client-side.
# AIBOS_META_WEBHOOK_VERIFY_TOKEN=install-through-secret-manager
# AIBOS_META_WEBHOOK_SIGNING_SECRET=install-through-secret-manager
# AIBOS_MICROSOFT_OAUTH_CLIENT_ID=install-through-deployment-platform
# AIBOS_MICROSOFT_OAUTH_CLIENT_SECRET=install-through-secret-manager

# Public abuse controls. The in-process chatbot limiter is defense in depth;
# production additionally requires a real edge/WAF rate-limit policy.
AIBOS_CHATBOT_SESSION_CREATIONS_PER_MINUTE=10
AIBOS_CHATBOT_MESSAGES_PER_MINUTE=20
AIBOS_CHATBOT_LEADS_PER_HOUR=5
AIBOS_CHATBOT_ORDER_ATTEMPTS_PER_HOUR=5
AIBOS_CHATBOT_BOOKING_ATTEMPTS_PER_HOUR=5
