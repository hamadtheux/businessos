# Public build-time values only. Never place API keys or provider secrets in VITE_*.
# Leave API_BASE_URL empty when frontend and /api share one production origin.
VITE_API_BASE_URL=http://localhost:8000
VITE_WIDGET_API_BASE_URL=http://localhost:8000
VITE_WIDGET_APP_URL=http://localhost:5174/widget.html
VITE_ENABLE_DEMO_DATA=false
